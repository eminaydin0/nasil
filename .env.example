# ─── Yerel geliştirme (.env git'e GİTMEZ) ───
# AI: npm run dev yeterli (/api/ai Vite plugin ile gelir)

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Site URL
VITE_SITE_URL=http://localhost:5173

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-FSCZ2DPYWG

# ─── Gemini AI (sadece sunucu — VITE_ ÖNEKİ YOK, tarayıcıya gitmez) ───
# https://aistudio.google.com/apikey
# Yerel: .env | Canlı: Vercel → Settings → Environment Variables → GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Admin AI koruması (isteğe bağlı ama önerilir — rastgele uzun string)
# Vercel'de ADMIN_AI_SECRET ve VITE_ADMIN_AI_SECRET aynı değer olmalı
ADMIN_AI_SECRET=
VITE_ADMIN_AI_SECRET=
